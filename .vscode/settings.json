{
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.latex.outDir": "./build",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk_xelatex",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=build",
        "%DOC%"
      ]
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "XeLaTeX",
      "tools": ["latexmk_xelatex"]
    }
  ],

  "files.exclude": {
    "src/build": true,
    "src/cover": true,
    "src/lab-01": true,
    "src/lab-02": true
    // "src/lab-03": true
  }
}
